# Copy to web/.env.local (gitignored) and fill in. In production set these in Vercel > Settings > Environment Variables.
# Without any key the app still works: the SI briefing falls back to a labelled deterministic brief.
# Set a monthly spend limit on whichever provider account you use.
#
# Option A: set ONE vendor key. The first one found is used, in this order.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
#
# Option B: one generic key. The vendor is detected from the key's prefix
# (sk-ant- = Anthropic, AIza or AQ. = Gemini, other sk- keys = OpenAI). DeepSeek keys also start with sk-,
# so add SI_PROVIDER=deepseek for those.
# SI_API_KEY=
# SI_PROVIDER=anthropic | openai | deepseek | gemini | custom
#
# Optional overrides
# SI_MODEL=            # e.g. claude-haiku-5-5, gpt-5.4-mini, deepseek-flash, gemini-3.8-flash
# SI_BASE_URL=         # any OpenAI-compatible endpoint (OpenRouter, Groq, Mistral, local Ollama...);
#                      # with SI_API_KEY + SI_MODEL this selects the "custom" provider
# ANTHROPIC_VERSION=2023-06-01
